# print：打印操作，可以打印字符串、变量...
print("Hello","world",sep="_",end="。")                       # sep: 字符间以什么分隔,
                                                             # end：以什么结尾，默认\n换行符

# input:输入操作,但输入格式位字符串格式...如需要，请自行转换
input()

# input的括号里也可以写字的，就像提示词，输入的内容不会和它混在一起
print(input("输入："))                                       # 输入：→ 输入：fff → fff    # 看吧，一点事也没有(套娃)


# 定义变量：将数据赋值给变量名
num1 = "你"
num2 = "好"
a = "吗"
total = num1 + num2 + a                                       # ‘+’ 拼接变量
print(total + "?")                                            # 你好吗?

print(type(num1))                                             # type():查看目标类型
                                                              # <class 'str'> 字符串类型

# 噔噔，常用类型小课堂：
a = 1                                                           # int：整型
b = 1.0                                                         # float：浮点型
c = "1"                                                         # str：字符串
d = True                                                        # bool：布尔类型，True（非0）/ False（0）
                                                                # 注意：True/False 本质是 bool 类型，但也能当作 1 / 0 使用
                                                                # bool 是 int 的子类（True == 1 → True）

e = None                                                        # None：空（啥也没有），类型是 NoneType
                                                                # 注意：在 if 判断中，None 会被当作 False，但：
                                                                # False != None（两者类型不同，值也不同）


print(type(a),type(b),type(c),type(d),type(e))                  # <class 'int'> <class 'float'> <class 'str'> <class 'bool'> <class 'NoneType'>

# 所以捏，数据也可以是字符串，数值...

Name = "bai"
print("我的名字:%s"%Name)                                      # 古老的C语言格式化符(其实可以直接用f格式化)：如
# print(f"我的名字:{Name}")                                    # %s：字符串(自动调用 str())

Age = 17
print("我的名字:%s,年龄:%d"%(Name,Age))                        # %d:十进制整数(int)
                                                              # %r:原始字符串（调用 repr()）         "对象是：%r" % "bai" → '对象是："bai"'
                                                              # %i:同 %d，但更宽容(可自动转换为 int)  "编号:%i" % 17.9 → '编号:17'
                                                              # %f:浮点数（默认保留6位小数）	      "分数:%f" % 88.5 → '分数:88.500000'
                                                              # %.2f:浮点数（指定保留2位）	          "分数:%.2f" % 88.5 → '分数:88.50'
                                                              # %e/%E:科学计数法(小写/大写E)	      "%e" % 1000 → '1.000000e+03'
                                                              # %o:八进制(octal)                   "%o" % 8 → '10'
                                                              # %x/%X:十六进制（小写/大写）          "%x" % 255 → 'ff'
                                                              # %c:单个字符(传入字符或ASCII码)       "%c" % 65 → 'A'


# 运算符：+-*/,//,%,**
print(1 + 1)                                                    # 1 + 1 = 2 不用多说吧？
print(1 + 1.0)                                                  # 2.0 只要目标中有一个浮点类型，那么结果也一定会是浮点型

print(3 - 1)                                                    # 2
print(1 * 2)                                                    # *:乘法 1 * 2 = 2

print(4 / 2)                                                    # /:除法 4/2 = 2.0 自动创建浮点型了
print(5 / 2)                                                    # 2.5

print(2 ** 3)                                                   # **：幂(次方)
                                                                # 2^3 = 8

------------------------------------------------------------------------------------------------------------------------------------

# if判断语句：如果/否则
if Age > 18:                                                  # 如果你大于18
    print("好老。")                                            # 那么你老了

elif Age == 18:                                               # 但如果你等于18
    print("年轻人不错哟。")                                     # 哎呀，青春正当年呐

else:                                                         # 如果没有
    print("未成年人禁止入内。")                                 # 未成年禁止嗷

# if和else就是绝对判断，elif只有当if不成立时才触发，如果if和elif都不成立，那就else了(elif,可以设置多个)
