# 进程 (进程是运行中的程序实例，每个进程有唯一的 PID )

# ps : 静态快照
# 常见的进程状态码(R:运行中，S:可中断睡眠(等待事件)，D:不可中断睡眠(通常等待I/O)，T:停止(被作业控制或调试)，Z:僵尸进程(已终止，但父进程未回收)
ps -p 1                # 查看PID=1的进程，PID1通常是systemd或其他init系统，是所有用户进程的祖先进程。如果PID1出问题，系统基本完蛋
ps -o pid,ppid,cmd     # 查看当前进程是谁（PID），它爹是谁（PPID），它启动了什么命令（CMD）。每输入一串指令都是一段进程，bash存在也是一段进程
ps aux                 # 查看所有进程 (a:显示所有终端进程，包括其他用户，u:以用户为主的格式显示，x显示没有控制终端的进程)

ps aux | grep nginx    # 管道组合，查看特定进程（但会包含grep自己，不推荐）
ps -C nginx -f         # 使用 ps -C name（推荐）-f 查看完整信息

top                    # 动态实时查看进程（类似任务管理器），按P按CPU排序，M按内存排序，q退出
htop                   # top增强版（需要先安装）

kill 1234              # 给 PID=1234 的进程发信号，默认信号是TERM (15)，通常能正常终止，但不是马上
kill -9 1234           # 强制杀死 PID=1234 的进程，发送的信号是KILL (9)，进程无法捕获
killall process_name   # 按进程名终止所有匹配的进程
pkill process_name     # 按进程名或其他属性终止进程

# 其他常用信号: HUP(1):重新加载配置(通常用于守护进程) INT(2):中断(相当于Ctrl+C)


# systemd 是linux的初始化系统（init system）和服务器管理器，是启动后的第一个用户空间程序（PID=1）
# 负责系统服务（网络，ssh，nginx等），后台守护进程（daemon），监控服务状态，处理开机启动项，管理日志（journal），控制系统电源状态（开机/关机）
# 启动大致顺序：BIOS -> Bootloader(grub) -> Kernel -> systemd(PID 1) -> 各种系统 -> 用户登录

# Unit：systemd管理的对象
# 常见类型：service(服务) , socket(套接字) , target(运行级别) , mount(挂载) , time(定时任务)
# 配置文件位于：
/etc/systemd/system/ : 系统管理员自定义的unit(优先级高)
/lib/systemd/system/ : 软件包自带的unit(避免直接修改)

# systemctl : 管理 systemd 的命令

systemctl status nginx             # 查看nginx进程的状态

sudo systemctl start nginx         # 启动服务
sudo systemctl stop nginx          # 停止服务
sudo sysemctl restart nginx        # 重启

sudo systemctl enable eginx        # 设置为开机自启动
sudo systemctl disabel --now nginx # 停止服务+取消开机自启动（--now 表示立即执行stop，可以不加）
# enable 的本质是：在 /etc/systemd/system/ 下创建一个符号链接，把 nginx.service 挂到某个 target（通常是 multi-user.target）
# disabel 就是将某unit从里面取消挂载

sudo systemctl mask nginx          # 如果需要彻底禁止还能被某依赖拉起
sudo systemctl unmask nginx        # 恢复

systemctl is-enabled               # 查看是否开机自启，可能返回（enabled（是），disabled（否），static（只能被其他unit依赖拉起，不能自启动），maked（完全禁止启动））

# 列出所有正在运行的services
systemctl list-units --type=service --state=runnin

# 查看服务日志 (journaltcl是systemd的日志查看工具，可以查看所有日志)
journalctl -u nginx                # 查看指定服务的日志
journalctl -u nginx -f             # 实时跟踪服务日志


# 创建自定义服务
# 假设写了一个python脚本 /home/user/myapp/app.py , 需要让它作为服务运行

# 1.创建文件
touch /etc/systemd/system/myapp.service

# 2.编辑文件
[Unit]                                   # 所有systemd单元的通用配置段
Description=My python Application        # 一个人类可读的描述，查看状态/日志时，这个描述会显示出来              
After=network.target                     # 指定在 network.target 之后启动，确保网络服务启动后才启动 (非强依赖)

[Service]                                # 服务单元特有配置段，定义如何启动，停止服务和服务的行为
User=user_name                           # 指定运行此服务的用户
WorkingDirectory=/home/user/myapp        # 设置工作目录，当服务启动后，会以此目录为当前工作目录

ExecStart=/usr/bin/python3 /home/user/myapp/app.py    # 定义启动服务时要执行的完整命令行，通常包括可执行文件的绝对路径和参数
# systemd要求使用绝对路径，且命令应该只在前台运行。
# 如果脚本需要参数，可以附加在后面： /usr/bin/python3 /home/user/myapp/app.py --port=8080。

Restart=always   # 定义服务退出后何时自动重启，always:表示无论因何原因退出(正常或奔溃)，systemd都会尝试重启
# 其他常见值：no(默认，不自动重启)，on-failure(仅在非正常退出后重启)，on-success(仅在正常退出后重启)

[Install]                               # 一个声明，定义了如果enabel，那么该服务将如何安装到系统启动流程中(如何启用开机自启)
WantedBy=multi-user.target              # 当系统进入multi-user.target时，此服务会被启动(即开机自启)。大多数Linux系统默认启动到此target

# 3.执行
sudo systemctl daemon-reload            # 重新加载systemd配置，使其识别到新的/修改过的服务文件
sudo systemctl start myapp
sudo systemctl enable myapp             # 开机自启
