# Nginx：一个高性能的开源Web服务器，常作为：
反向代理（将客户端请求转发给后端服务器）
负载均衡（将流量分发到多台服务器）
静态文件服务（高效提供HTML，CSS，图片等静态资源
HTTP缓存（缓存后端响应，减少服务器压力）

# 安装（默认监听80端口）
sudo apt install nginx

# 配置目录结构
主配置：/etc/nginx/nginx.conf
站点配置：/etc/nginx/sites-available/
启用站点(存放软链接，非真实文件)：/etc/nginx/sites-enabled/
日志：
/var/log/nginx/access.log
/var/log/nginx/error.log

# 最小静态站点
sudo mkdir -p /srv/site1      # 创建目录
echo "<h1>Sitel1</h1>" | sudo tee /srv/site1/index.html    # 写入内容

sudo nano /etc/nginx/sites-sites-available/site1           # 新建配置
# 写入：
server {
    listen 80;
    server_name _;

    root /srv/site1;
    index index.heml;

    location / {                                           # 定义如何处理请求，/ 表示匹配所有路径（根路径及以下所URL）
      try_files $uri $uri/ =404;                           # 依次尝试以下方法，$uri（先找有没有这个文件）， $uri（再找有没有这个目录），如果前两步都找不到，就返回404错误
    }

}
# 启用：
sudo ln -s /etc/nginx/sites-available/site1 /etc/nginx/sites-enabled/    # 制作软链接，禁用时直接删除软链接，不需要动文件
sudo rm /etc/nginx/sites-enabled/default                                 # 删除默认页面的软链接
sudo nginx -t    # 测试
sudo systemctl reload nginx    # 重新加载
