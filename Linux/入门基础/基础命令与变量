# 系统信息命令
whoami                 # 内核眼里，我现在是谁？（用户名/root）
id                     # uid（用户身份），gid（主组），groups（能用哪些附加权限）
uname -a               # 操作系统的内核是什么？（内核类型,主机名,内核版本,编译信息,架构，用户环境）
                       # 常见的几种内核抢占模型：PREEMPT_NONE（高延迟高吞吐），PREEMPT_VOLUNTARY（中延迟中吞吐），PREEMPT（低延迟低吞吐），PREEMPT_DYNAMIC（可切换）    

lsb_release -a         # 用的发行版是哪家? (发行方,人类可读名称,发行版本,代号) 。当某些最小系统/容器里 没有 lsb_release 时可以用：cat /etc/os-release

# 系统状态
df -h                  # 查看磁盘使用情况（人类可读）
du -sh folder/         # 查看目录大小
free -h                # 查看内存使用情况
type cd                # 可查看指令是否为shell内建（builtin 不会 fork 新进程，必须在 bash 里执行）

# 管道，将前一个命令的输出作为后一个命令的输入
ls -la | grep ".txt"        # 只显示txt文件的长格式
ps aux | grep python        # 查找python进程
cat file.txt | sort | uniq  # 排序并去重
history | grep "git"        # 查找历史中的git命令

# 三个标准文件描述符
# (0:stdin,1:stdout,2:stderr)

# 输出重定向
ls &> file.txt              # 将所有输出(标准输出（stdout）和 标误输出（stderr）)重定向写入file(覆盖)
ls > file.txt               # 将ls的标准输出（stdout）写入
ls >> file.txt              # 追加写入
command 2> error.los        # 把错误信息（stderr）单独重定向到文件,command指代任何指令（但确实存在一个同名的内建指令）
                            # command -v ls 用来执行命令或检查命令类型

echo "hello" | sudo tee file.txt    # 有时候因为 > 重定向是由当前用户执行，不受sudo影响，会提示权限不足。而tee命令读取标准输入，然后同时输出到屏幕和文件（可受到sudo影响）

# 输入重定向
sort < file.txt             # 从文件中读取输入
cat << EOF                  # 多行输入，把后面的多行文本作为标准输入传给 cat
> Line1
> Line2
> EOF                       # 直到再遇到 EOF 为止

# 通配符
ls *.txt                    # 所有结尾为txt的文件
ls file?.txt                # file(n) 等等.txt
ls file[0-9]                # file0 - file9 的.txt
ls file{A,B,C}.txt          # fileA.txt,fileB.txt,fileC.txt
ls **/*.py                  # 所有子目录(包括本层)中的py文件(*代表本层，**代表自身以及继续往下的整颗目录树，需要先使用 shopt -s globstar )

# 写
echo                        # 把字符串写到标准输出
printf                      # 而当前进程的stdout默认连接到终端，输出会出现在屏幕上

# 环境变量（ 由shell维护，传递给子进程的一组键值对。用于配置程序行为，指定路径，传递运行参数，保存用户/系统信息 ）
env                         # 查看所有环境变量
printenv                    # 同上

# 常用的环境变量
echo $HOME                  # 家目录
echo $PATH                  # 命令搜索路径
echo $USER                  # 当前用户名
echo $SHELL                 # 当前shell（命令解释器）
echo $PWD                   # 当前目录（由shell维护，可以export修改，可能被篡改(环境变量本质还是一组键值对，非pwd命令直接向系统询问)）

# 局部变量(只存在于当前shell，子进程看不到)
name="Bai"                  # 定义变量（等号两边不能有空格）
echo "hello $name"          # hello Bai

# 命令替换
current_data=$(data)        # 先执行data，再把输出结果作为字符串替换进变量（current_data）

unset name                  # 彻底删除变量
export name=xxx             # 变成环境变量

# 特殊变量
echo $?                     # 上一个命令的推出状态（0=成功）
echo $$                     # 当前shell的进程PID
echo $!                     # 最后一个后台进程的PID
