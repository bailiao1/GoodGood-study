extends Node					    # 绑定节点

# 变量
var a :String= "1"                                  # :声明变量类型
var b :int = 1
var c :float = 2.6
var d :bool = true

func _enter_tree():
  self.a = str(b)                                   # 转str
	a = "hello world"
	print(a)

  b = c                                             # float转int，直接去掉小数位：2
  print(b)

  d = b                                             # int转bool,除0以外都是true
  print(d)                                          # true
  d = !d                                            # 布尔值取反
  print(d)                                          # false


# 数组
var b = [1,2.1,"3",true]
