#include <stdio.h>              // printf 和 scanf 的头文件
#include <string.h>             // strlen() 的头文件
#define MAX 100                 // 定义标识符常量，编译时简单替换为 100
#define STR "abcdef"            // 定义字符串常量，注意使用英文半角引号，表示字符串 "abcdef"

// 枚举类型定义：Color
enum Color                     // 创建一个枚举类型 Color
{
    RED,                       // RED 对应整数值 0
    GREEN,                     // GREEN 对应整数值 1
    BLUE                       // BLUE 对应整数值 2
};

int b = 0;                      // 全局变量，在整个程序中都可以访问与修改

int main()
{   
    // extern int c;            // 声明一个外部变量，实际定义不在本文件中，编译时需链接
    const int a = 0;            // 定义一个常量变量 a，值为 0，无法修改（只读）
    enum Color d = RED;         // 定义一个枚举变量 d，并赋值为 RED (即 0)
    char arr[] = "abc";

    /*
     * 🚩 错误示例：
     * scanf("%d %d", &a, &b); // 尝试通过指针修改 const 变量，会报错或警告
     * 原因：a 是常量，不允许通过指针修改。
     * 正确的做法是要么去掉 const，要么不要试图修改 a 的值。
     */

    // ✅ 使用 printf() 输出常量和变量的值
    printf("a 的值：%d\n", a);           // 输出：0，const 变量的值是可以读取的
    printf("b 的值：%d\n", b);           // 输出：全局变量 b 的当前值，初始为 0
    printf("d 的值：%d\n", d);           // 输出：0，因为 d 是枚举类型，且赋值为 RED (0)
    printf("MAX 的值：%d\n", MAX);       // 输出：100，#define 替换为 100
    printf("STR 的值：%s\n", STR);       // 输出：abcdef，#define 替换为字符串 "abcdef"
    printf("arr数组的值：%s\narr数组的长度为：%zu",arr,strlen(arr));     // arr数组的值：abc
                                                                      // arr数组的长度为：3


    /*
     * ❌ 试图修改 const 变量的值（错误示例）：
     * scanf("%d %d", &a, &b);
     * 上述语句会报错或产生警告，因为我们不能通过指针修改一个 const 变量。
     * 解决方案：去掉 const 或者不要尝试修改它。
     */

    // ✅ 正确写法：修改非 const 的变量
    scanf("%d", &b);                     // 读取用户输入，并修改全局变量 b 的值
    int sum = a + b;                     // 可以参与运算，但不能修改 a
    printf("sum 的值：%d\n", sum);       // 输出求和结果，sum = a + b

    return 0;
}
