#include <stdio.h>


// 📌 函数声明 - 告诉编译器这个函数的存在，方便后面调用。
// 函数名称：add
// 参数：两个整数 x 和 y
// 返回值：两个整数相加的结果
int add(int x, int y)
{
    return x + y;  // 返回 x 和 y 的和
}

int main()
{
    // 🌟【1】分支语句示例（if-else）
    int a = 0;  // 定义一个整型变量 a 并初始化为 0
    printf("要好好学习嘛？(1/0)\n");  // 提示用户输入 1 或 0
    scanf("%d", &a);  // 从键盘获取用户输入，存储在变量 a 中

    // 条件判断
    if (a == 1)  // 如果用户输入的是 1
    {
        printf("good good\n");  // 输出鼓励语句
    }
    else  // 如果用户输入的不是 1
    {
        printf("那完了\n");  // 输出嘲讽语句 (⁀ᗢ⁀)
    }

    // 🌟【2】循环语句示例（while、for、do-while）

    int i = 0;  // 定义一个整型变量 i 用于计数

    // 🔄 while 循环：先判断条件再执行
    while (i < 5)
    {
        printf("%d\n", i);  // 输出当前 i 的值
        i++;  // i 自增 1
    }

    // 🔄 for 循环：适用于明确知道循环次数的情况
    for (; i < 10; i++)
    {
        printf("%d\n", i);  // 输出当前 i 的值
    }

    // 🔄 do-while 循环：先执行一次循环体，再判断条件
    do
    {
        printf("%d\n", i);  // 输出当前 i 的值
        i++;  // i 自增 1
    } while(i < 15);  // 当 i 小于 15 时继续循环

    // 🌟【3】函数调用示例

    int c = 0;  // 定义一个整型变量 c
    int d = 0;  // 定义一个整型变量 d
    
    // 提示用户输入两个数字
    printf("请输入两个数字：\n");
    scanf("%d %d", &c, &d);  // 从键盘获取用户输入，存储在变量 c 和 d 中

    // 调用函数 add 并将结果赋给 sum
    int sum = add(c, d);
    printf("sum = %d\n", sum);  // 输出两个数字相加的结果

    // 🌟【4】程序结束
    return 0;  // 返回 0 表示程序正常结束
}
